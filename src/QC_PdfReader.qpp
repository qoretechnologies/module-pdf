#include "QC_PdfReader.h"
#include "PdfReader.h"

//! A read-only PDF reader
/**
    @since %pdf 1.0
*/
qclass PdfReader [arg=QorePdfReader* reader; ns=Qore::Pdf];

//! Opens a PDF file for reading
/** @param path the PDF file path
    @param password optional password

    @throw PDF-ERROR if the document cannot be opened
*/
PdfReader::constructor(string path, *string password) [dom=FILESYSTEM] {
    if (!path || path->empty()) {
        xsink->raiseException("PDF-ERROR", "path is required");
        return;
    }
    ReferenceHolder<QorePdfReader> holder(new QorePdfReader(path->c_str(),
        password ? password->c_str() : "", xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_PDFREADER, holder.release());
}

//! Returns the page count
/** @return the number of pages

    @throw PDF-ERROR if the document is not initialized or cannot be read
*/
int PdfReader::pageCount() {
    return reader->pageCount(xsink);
}

//! Returns document metadata
/** @return a @ref Qore::Pdf::PdfMetadata hash

    @throw PDF-ERROR if metadata cannot be read
*/
hash<PdfMetadata> PdfReader::metadata() {
    return reader->getMetadata(xsink);
}
