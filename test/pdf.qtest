%modern

%requires QUnit
%requires Util
%requires pdf

%exec-class PdfTest

public class PdfTest inherits QUnit::Test {
    private {
        string testDir;
        string basePdf;
    }

    constructor() : Test("PdfTest", "1.0") {
        testDir = tmp_location() + "/pdf_test_" + string(getpid());
        basePdf = testDir + "/base.pdf";

        addTestCase("Writer tests", \writerTest());
        addTestCase("Document read tests", \documentReadTest());
        addTestCase("Document edit tests", \documentEditTest());
        addTestCase("Merge and split tests", \mergeSplitTest());
        addTestCase("Renderer tests", \rendererTest());
        addTestCase("Font options tests", \fontOptionsTest());
        addTestCase("Negative tests", \negativeTest());
        addTestCase("Corner case tests", \cornerCaseTest());
        addTestCase("Password-protected PDF tests", \passwordProtectedTest());
        addTestCase("Large page count tests", \largePageCountTest());
        addTestCase("Corrupt PDF tests", \corruptPdfTest());
        addTestCase("Warnings capture tests", \warningsTest());
        addTestCase("Named argument tests", \namedArgumentTest());

        set_return_value(main());
    }

    globalSetUp() {
        mkdir(testDir);
    }

    globalTearDown() {
        if (is_dir(testDir)) {
            system("rm -rf " + testDir);
        }
    }

    private string createPdf(string path, string text, *hash<PdfMetadata> metadata = NOTHING) {
        PdfWriter writer();
        writer.addTextPage(text);
        if (metadata) {
            writer.setMetadata(metadata);
        }
        writer.save(path);
        return path;
    }

    private string createPdfWithFontOptions(string path, string text, hash<PdfFontOptions> opts) {
        PdfWriter writer();
        writer.setFontOptions(opts);
        writer.addTextPage(text);
        writer.save(path);
        return path;
    }

    writerTest() {
        PdfWriter writer();
        writer.addBlankPage();
        writer.addTextPage("Hello PDF");
        assertEq(2, writer.pageCount(), "writer counts pages before save");

        writer.save(basePdf);
        assertEq(True, is_file(basePdf), "writer saved PDF file");
    }

    documentReadTest() {
        createPdf(basePdf, "Metadata test", <PdfMetadata>{
            "title": "Test Title",
            "author": "Qore",
            "subject": "Unit Test",
        });

        PdfDocument doc(basePdf);
        assertEq(1, doc.pageCount(), "document page count");

        hash<PdfMetadata> meta = doc.metadata();
        assertEq("Test Title", meta.title, "metadata title");
        assertEq("Qore", meta.author, "metadata author");
        assertEq("Unit Test", meta.subject, "metadata subject");

        PdfReader reader(basePdf);
        assertEq(1, reader.pageCount(), "reader page count");
        assertEq("Test Title", reader.metadata().title, "reader metadata title");
    }

    documentEditTest() {
        string editPdf = testDir + "/edit.pdf";
        createPdf(basePdf, "Edit test");

        PdfDocument doc(basePdf);
        doc.setMetadata(<PdfMetadata>{"title": "Updated"});
        list<int> pages = ();
        pages += 0;
        doc.rotatePages(pages, 90);
        doc.save(editPdf);

        PdfDocument check(editPdf);
        assertEq("Updated", check.metadata().title, "metadata update persisted");
    }

    mergeSplitTest() {
        string pdf1 = testDir + "/merge1.pdf";
        string pdf2 = testDir + "/merge2.pdf";
        createPdf(pdf1, "One");
        createPdf(pdf2, "Two");

        PdfDocument merged = PdfDocument::merge((pdf1, pdf2));
        string mergedPath = testDir + "/merged.pdf";
        merged.save(mergedPath);
        assertEq(True, is_file(mergedPath), "merged PDF saved");

        PdfDocument mergedDoc(mergedPath);
        assertEq(2, mergedDoc.pageCount(), "merged PDF has 2 pages");

        string splitDir = testDir + "/split";
        mkdir(splitDir);
        list<string> outputs = PdfDocument::split(mergedPath, splitDir, "part_");
        assertEq(2, outputs.size(), "split returns one path per page");
        foreach string out in (outputs) {
            assertEq(True, is_file(out), "split output exists");
        }
    }

    rendererTest() {
        if (!PdfRenderer::isAvailable()) {
            bool thrown = False;
            try {
                PdfRenderer::renderPage(basePdf, 0, 150);
            } catch (hash<ExceptionInfo> ex) {
                thrown = True;
                assertEq("PDF-ERROR", ex.err, "renderPage errors when PDFium missing");
            }
            assertTrue(thrown, "renderPage throws when PDFium missing");
            return;
        }

        createPdf(basePdf, "Render test");
        hash<PdfRenderResult> result = PdfRenderer::renderPage(basePdf, 0, 72);
        assertTrue(result.width > 0, "rendered width > 0");
        assertTrue(result.height > 0, "rendered height > 0");
        assertEq("BGRA", result.format, "render format");
        assertTrue(result.data.size() > 0, "render data present");

        string text = PdfRenderer::extractText(basePdf, 0);
        assertTrue(text.find("Render test") >= 0, "extracted text contains content");
    }

    fontOptionsTest() {
        *string mode_filter = getenv("PDF_FONT_MODE");

        hash<string, hash<PdfFontOptions>> modes = (
            "embed+subset": <PdfFontOptions>{
                "embed": True,
                "subset": True,
                "prefer_non_cid": False,
            },
            "embed+no-subset": <PdfFontOptions>{
                "embed": True,
                "subset": False,
                "prefer_non_cid": False,
            },
            "embed+prefer-non-cid": <PdfFontOptions>{
                "embed": True,
                "subset": True,
                "prefer_non_cid": True,
            },
            "no-embed": <PdfFontOptions>{
                "embed": False,
                "subset": False,
                "prefer_non_cid": False,
            }
        );

        foreach string mode in (modes.keys()) {
            if (mode_filter && mode_filter != mode) {
                continue;
            }
            string out = testDir + "/font_" + mode + ".pdf";
            createPdfWithFontOptions(out, "Font test " + mode, modes{mode});
            assertEq(True, is_file(out), "font option " + mode + " produced PDF");
        }
    }

    negativeTest() {
        bool thrown = False;
        try {
            PdfDocument doc(testDir + "/missing.pdf");
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "missing file throws PDF-ERROR");
        }
        assertTrue(thrown, "missing file throws");

        createPdf(basePdf, "Negative test");
        PdfDocument doc(basePdf);

        thrown = False;
        try {
            list<int> pages = ();
            pages += 0;
            doc.rotatePages(pages, 45);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "invalid rotation throws PDF-ERROR");
        }
        assertTrue(thrown, "invalid rotation throws");

        thrown = False;
        try {
            list<int> pages = ();
            pages += 999;
            doc.rotatePages(pages, 90);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "invalid page index throws PDF-ERROR");
        }
        assertTrue(thrown, "invalid page index throws");

        thrown = False;
        try {
            PdfDocument::merge(());
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "merge empty list throws PDF-ERROR");
        }
        assertTrue(thrown, "merge empty list throws");
    }

    cornerCaseTest() {
        string singlePdf = testDir + "/single.pdf";
        createPdf(singlePdf, "Single page");

        PdfDocument doc(singlePdf);
        list<int> emptyPages = ();
        doc.rotatePages(emptyPages, 90);
        assertEq(1, doc.pageCount(), "rotate on empty page list is no-op");

        list<string> outputs = PdfDocument::split(singlePdf, testDir, "single_");
        assertEq(1, outputs.size(), "split single-page returns one file");
    }

    passwordProtectedTest() {
        # Create a password-protected PDF using qpdf command-line tool
        string unprotectedPdf = testDir + "/unprotected.pdf";
        string protectedPdf = testDir + "/protected.pdf";
        createPdf(unprotectedPdf, "Secret content", <PdfMetadata>{"title": "Protected Doc"});

        # Use qpdf to encrypt the PDF with a password
        int rc = system("qpdf --encrypt userpass ownerpass 256 -- " + unprotectedPdf + " " + protectedPdf);
        if (rc != 0) {
            testSkip("qpdf not available for creating encrypted PDFs");
            return;
        }

        # Test 1: Opening without password should fail
        bool thrown = False;
        try {
            PdfDocument doc(protectedPdf);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "protected PDF without password throws PDF-ERROR");
        }
        assertTrue(thrown, "opening protected PDF without password throws");

        # Test 2: Opening with correct password should succeed
        PdfDocument doc(protectedPdf, "userpass");
        assertEq(1, doc.pageCount(), "protected PDF opened with password");
        assertEq("Protected Doc", doc.metadata().title, "protected PDF metadata readable");

        # Test 3: Opening with wrong password should fail
        thrown = False;
        try {
            PdfDocument doc2(protectedPdf, "wrongpassword");
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "wrong password throws PDF-ERROR");
        }
        assertTrue(thrown, "wrong password throws");

        # Test 4: PdfReader with password
        PdfReader reader(protectedPdf, "userpass");
        assertEq(1, reader.pageCount(), "PdfReader opens protected PDF");

        # Test 5: Merge with password-protected PDFs
        string protectedPdf2 = testDir + "/protected2.pdf";
        string unprotectedPdf2 = testDir + "/unprotected2.pdf";
        createPdf(unprotectedPdf2, "More secret content");
        system("qpdf --encrypt userpass ownerpass 256 -- " + unprotectedPdf2 + " " + protectedPdf2);

        PdfDocument merged = PdfDocument::merge((protectedPdf, protectedPdf2), "userpass");
        assertEq(2, merged.pageCount(), "merge protected PDFs succeeds with password");
    }

    largePageCountTest() {
        # Test creating a PDF with many pages
        string largePdf = testDir + "/large.pdf";
        int pageCount = 100;

        PdfWriter writer();
        for (int i = 0; i < pageCount; i++) {
            writer.addBlankPage();
        }
        assertEq(pageCount, writer.pageCount(), "writer tracks large page count");
        writer.save(largePdf);

        # Read back and verify
        PdfDocument doc(largePdf);
        assertEq(pageCount, doc.pageCount(), "large PDF has correct page count");

        # Test rotating multiple pages in a large PDF
        list<int> pagesToRotate = ();
        for (int i = 0; i < 10; i++) {
            pagesToRotate += i * 10;  # Rotate every 10th page
        }
        doc.rotatePages(pagesToRotate, 90);

        string rotatedPdf = testDir + "/large_rotated.pdf";
        doc.save(rotatedPdf);
        assertEq(True, is_file(rotatedPdf), "large rotated PDF saved");

        # Test splitting a large PDF
        string splitDir = testDir + "/large_split";
        mkdir(splitDir);
        list<string> outputs = PdfDocument::split(largePdf, splitDir, "page_");
        assertEq(pageCount, outputs.size(), "split large PDF returns correct count");

        # Verify first and last split files exist
        assertEq(True, is_file(outputs[0]), "first split page exists");
        assertEq(True, is_file(outputs[pageCount - 1]), "last split page exists");

        # Test merging many PDFs
        list<string> toMerge = ();
        for (int i = 0; i < 10 && i < outputs.size(); i++) {
            toMerge += outputs[i];
        }
        PdfDocument mergedLarge = PdfDocument::merge(toMerge);
        assertEq(10, mergedLarge.pageCount(), "merge 10 single-page PDFs");
    }

    corruptPdfTest() {
        # Test 1: Empty file
        string emptyPdf = testDir + "/empty.pdf";
        {
            File f();
            f.open2(emptyPdf, O_CREAT | O_WRONLY | O_TRUNC);
            f.close();
        }

        bool thrown = False;
        try {
            PdfDocument doc(emptyPdf);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "empty file throws PDF-ERROR");
        }
        assertTrue(thrown, "empty file throws");

        # Test 2: Random binary garbage
        string garbagePdf = testDir + "/garbage.pdf";
        {
            File f();
            f.open2(garbagePdf, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(binary("This is not a PDF file at all - just random text garbage"));
            f.close();
        }

        thrown = False;
        try {
            PdfDocument doc(garbagePdf);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "garbage file throws PDF-ERROR");
        }
        assertTrue(thrown, "garbage file throws");

        # Test 3: Truncated PDF header only
        string truncatedPdf = testDir + "/truncated.pdf";
        {
            File f();
            f.open2(truncatedPdf, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(binary("%PDF-1.4\n"));  # Valid header but no content
            f.close();
        }

        thrown = False;
        try {
            PdfDocument doc(truncatedPdf);
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "truncated PDF throws PDF-ERROR");
        }
        assertTrue(thrown, "truncated PDF throws");

        # Test 4: Valid PDF with corrupted content (create valid then corrupt)
        string corruptedPdf = testDir + "/corrupted.pdf";
        createPdf(testDir + "/valid_for_corrupt.pdf", "Valid content");
        {
            # Read the valid PDF
            File f();
            f.open2(testDir + "/valid_for_corrupt.pdf", O_RDONLY);
            binary content = f.readBinary(-1);
            f.close();

            # Corrupt middle section by replacing bytes with garbage
            if (content.size() > 200) {
                binary corrupted = content.substr(0, 100) + binary("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX") + content.substr(150);
                content = corrupted;
            }

            # Write corrupted version
            File f2();
            f2.open2(corruptedPdf, O_CREAT | O_WRONLY | O_TRUNC);
            f2.write(content);
            f2.close();
        }

        thrown = False;
        try {
            PdfDocument doc(corruptedPdf);
            # Some corrupted PDFs may still open - try to access content
            doc.pageCount();
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "corrupted PDF throws PDF-ERROR");
        }
        # Note: Some corrupted PDFs may still be partially readable by QPDF,
        # so we don't require an exception here - just verify the error type if thrown

        # Test 5: Merge with one corrupt file
        string validPdf = testDir + "/valid_for_merge.pdf";
        createPdf(validPdf, "Valid");

        thrown = False;
        try {
            PdfDocument::merge((validPdf, garbagePdf));
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "merge with corrupt file throws PDF-ERROR");
        }
        assertTrue(thrown, "merge with corrupt file throws");

        # Test 6: Split corrupt PDF
        thrown = False;
        try {
            PdfDocument::split(garbagePdf, testDir, "corrupt_");
        } catch (hash<ExceptionInfo> ex) {
            thrown = True;
            assertEq("PDF-ERROR", ex.err, "split corrupt file throws PDF-ERROR");
        }
        assertTrue(thrown, "split corrupt file throws");

        # Test 7: Renderer with corrupt PDF (if PDFium available)
        if (PdfRenderer::isAvailable()) {
            thrown = False;
            try {
                PdfRenderer::renderPage(garbagePdf, 0, 72);
            } catch (hash<ExceptionInfo> ex) {
                thrown = True;
                assertEq("PDF-ERROR", ex.err, "render corrupt file throws PDF-ERROR");
            }
            assertTrue(thrown, "render corrupt file throws");

            thrown = False;
            try {
                PdfRenderer::extractText(garbagePdf, 0);
            } catch (hash<ExceptionInfo> ex) {
                thrown = True;
                assertEq("PDF-ERROR", ex.err, "extract text from corrupt file throws PDF-ERROR");
            }
            assertTrue(thrown, "extract text from corrupt file throws");
        }
    }

    warningsTest() {
        # Test 1: Valid PDF should have no warnings
        string validPdf = testDir + "/warnings_valid.pdf";
        createPdf(validPdf, "Valid content for warnings test");

        PdfDocument validDoc(validPdf);
        *list<string> noWarnings = validDoc.getWarnings();
        assertEq(NOTHING, noWarnings, "valid PDF returns NOTHING for getWarnings()");

        # Test 2: Create a PDF with minor damage that QPDF can recover from
        # This creates a PDF with an invalid xref that QPDF will recover with warnings
        string damagedPdf = testDir + "/warnings_damaged.pdf";
        {
            # Read the valid PDF as binary
            File f();
            f.open2(validPdf, O_RDONLY);
            binary content = f.readBinary(-1);
            f.close();

            # Convert to string to find xref position (in ASCII portion)
            string contentStr = content.toString("ISO-8859-1");

            # Damage the xref entry - replace a digit with a letter in the xref table
            # This creates a recoverable error that QPDF will warn about
            int xrefPos = contentStr.find("xref");
            if (xrefPos >= 0) {
                # Find a position after xref to damage
                int damagePos = xrefPos + 20;
                if (damagePos < contentStr.size()) {
                    # Replace a character in the xref with something invalid
                    contentStr = contentStr.substr(0, damagePos) + "X" + contentStr.substr(damagePos + 1);
                }
            }

            # Write damaged version
            File f2();
            f2.open2(damagedPdf, O_CREAT | O_WRONLY | O_TRUNC);
            f2.write(binary(contentStr));
            f2.close();
        }

        # Try to open the damaged PDF - it may throw or generate warnings
        bool hasWarnings = False;
        try {
            PdfDocument damagedDoc(damagedPdf);
            *list<string> warnings = damagedDoc.getWarnings();
            if (warnings) {
                hasWarnings = True;
                assertTrue(warnings.size() > 0, "damaged PDF generates warnings");
                # Warnings should contain text about the damage
                assertTrue(warnings[0].size() > 0, "warning message is not empty");
            }
        } catch (hash<ExceptionInfo> ex) {
            # If it throws, that's also acceptable for a damaged PDF
            assertEq("PDF-ERROR", ex.err, "damaged PDF throws PDF-ERROR");
        }

        # Test 3: getWarnings() called multiple times should work
        PdfDocument validDoc2(validPdf);
        *list<string> w1 = validDoc2.getWarnings();
        *list<string> w2 = validDoc2.getWarnings();
        assertEq(w1, w2, "getWarnings() is idempotent for valid PDF");

        # Test 4: Create a PDF with missing startxref that QPDF can try to recover
        string noStartxrefPdf = testDir + "/warnings_no_startxref.pdf";
        {
            File f();
            f.open2(validPdf, O_RDONLY);
            binary content = f.readBinary(-1);
            f.close();

            string contentStr = content.toString("ISO-8859-1");

            # Remove the startxref line by replacing it with whitespace
            int startxrefPos = contentStr.find("startxref");
            if (startxrefPos >= 0) {
                int eofPos = contentStr.find("%%EOF", startxrefPos);
                if (eofPos > startxrefPos) {
                    # Replace the startxref and its value with spaces (keeping EOF)
                    string spaces = strmul(" ", eofPos - startxrefPos);
                    contentStr = contentStr.substr(0, startxrefPos) + spaces + contentStr.substr(eofPos);
                }
            }

            File f2();
            f2.open2(noStartxrefPdf, O_CREAT | O_WRONLY | O_TRUNC);
            f2.write(binary(contentStr));
            f2.close();
        }

        try {
            PdfDocument noStartxrefDoc(noStartxrefPdf);
            *list<string> warnings = noStartxrefDoc.getWarnings();
            if (warnings) {
                assertTrue(warnings.size() > 0, "PDF with damaged startxref generates warnings");
            }
        } catch (hash<ExceptionInfo> ex) {
            # Acceptable - severely damaged PDFs may throw
            assertEq("PDF-ERROR", ex.err, "PDF with damaged startxref throws PDF-ERROR");
        }
    }

    namedArgumentTest() {
        string namedPdf = testDir + "/named.pdf";
        string updatedPdf = testDir + "/named_updated.pdf";
        string editedPdf = testDir + "/named_edited.pdf";
        string mergedPdf = testDir + "/named_merged.pdf";
        string splitDir = testDir + "/named_split";
        mkdir(splitDir);

        PdfPage page(index: 2);
        assertEq(2, page.index(), "PdfPage constructor accepts named index");

        PdfWriter writer();
        writer.setFontOptions(options: <PdfFontOptions>{
            "embed": True,
            "subset": True,
            "prefer_non_cid": False,
        });
        writer.addBlankPage(height: 200.0, width: 300.0);
        writer.addTextPage(height: 400.0, text: "Named text", width: 300.0);
        writer.setMetadata(metadata: <PdfMetadata>{"title": "Named Title"});
        writer.save(path: namedPdf);
        assertEq(True, is_file(namedPdf), "named writer save created a PDF");

        binary pdfData = writer.saveToMemory();
        assertTrue(pdfData.size() > 0, "named writer saveToMemory returns data");

        PdfDocument doc(path: namedPdf);
        assertEq(2, doc.pageCount(), "PdfDocument file constructor accepts named path");
        assertEq("Named Title", doc.metadata().title, "metadata written with named args");

        PdfDocument docFromData(data: pdfData);
        assertEq(2, docFromData.pageCount(), "PdfDocument data constructor accepts named data");

        PdfReader reader(path: namedPdf);
        assertEq(2, reader.pageCount(), "PdfReader file constructor accepts named path");
        PdfReader readerFromData(data: pdfData);
        assertEq(2, readerFromData.pageCount(), "PdfReader data constructor accepts named data");

        doc.setMetadata(metadata: <PdfMetadata>{"title": "Updated Named Title"});
        list<int> pages = ();
        pages += 0;
        doc.rotatePages(degrees: 180, pages: pages);
        doc.save(path: updatedPdf);
        PdfDocument check(path: updatedPdf);
        assertEq("Updated Named Title", check.metadata().title, "document named metadata persisted");

        list<string> mergeInputs = (namedPdf, updatedPdf);
        PdfDocument merged = PdfDocument::merge(inputs: mergeInputs);
        merged.save(path: mergedPdf);
        assertEq(4, merged.pageCount(), "merge accepts named inputs");
        list<string> outputs = PdfDocument::split(prefix: "named_", output_dir: splitDir, input_path: mergedPdf);
        assertEq(4, outputs.size(), "split accepts named input_path/output_dir/prefix");

        PdfEditor editor(path: namedPdf);
        hash<auto> dims = editor.getPageDimensions(page_index: 0);
        assertEq(300.0, dims.width, "getPageDimensions accepts named page_index");
        editor.setFontOptions(options: <PdfFontOptions>{
            "embed": True,
            "subset": True,
            "prefer_non_cid": False,
        });
        hash<auto> style = {
            "font": {
                "family": "Helvetica",
                "size": 11.0,
            },
            "color": {
                "name": "blue",
            },
        };
        editor.drawText(opacity: 0.8, rotation: 0.0, style: cast<hash<Qore::Pdf::PdfTextStyle>>(style),
            y: 150.0, x: 36.0, text: "Named editor text", page_index: 0);
        editor.createFormField(options: {"default_value": "initial"}, height: 20.0, width: 120.0,
            y: 100.0, x: 36.0, page_index: 0, field_type: "text", name: "named_field");
        editor.save(path: editedPdf);

        PdfEditor edited(path: editedPdf);
        edited.setFormFieldValue(value: "updated", name: "named_field");
        assertEq("updated", edited.getFormFieldValue(name: "named_field"),
            "form field access accepts named arguments");
        binary editedData = edited.saveToMemory();
        PdfEditor editedFromData(data: editedData);
        assertEq(2, editedFromData.pageCount(), "PdfEditor data constructor accepts named data");

        if (!PdfRenderer::isAvailable()) {
            bool thrown = False;
            try {
                PdfRenderer::renderPage(dpi: 72, page_index: 0, path: namedPdf);
            } catch (hash<ExceptionInfo> ex) {
                thrown = True;
                assertEq("PDF-ERROR", ex.err, "renderPage with named args reports PDF-ERROR when unavailable");
            }
            assertTrue(thrown, "renderPage with named args throws when PDFium is missing");
            return;
        }

        hash<PdfRenderResult> rendered = PdfRenderer::renderPage(dpi: 72, page_index: 0, path: namedPdf);
        assertTrue(rendered.data.size() > 0, "renderPage accepts named args");
        hash<PdfRenderResult> renderedData = PdfRenderer::renderPageFromData(dpi: 72, page_index: 0, data: pdfData);
        assertTrue(renderedData.data.size() > 0, "renderPageFromData accepts named args");
        string text = PdfRenderer::extractText(page_index: 1, path: namedPdf);
        assertTrue(text.find("Named text") >= 0, "extractText accepts named args");
        string textFromData = PdfRenderer::extractTextFromData(page_index: 1, data: pdfData);
        assertTrue(textFromData.find("Named text") >= 0, "extractTextFromData accepts named args");
    }
}
