%requires qore >= 2.0

%requires DataProvider
%requires FileLocationHandler
%requires Mime
%requires pdf

%modern

module PdfDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for PDF documents";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-pdf";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new PdfDataProviderFactory());

        # Register the data provider application
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": PdfDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "PDF Document",
            "short_desc": "PDF manipulation and rendering",
            "desc": "Create, edit, and render PDF documents with metadata support",
            "groups": (DataProvider::AppGroup::Documents,),
            "logo": Priv::PdfLogo,
            "logo_file_name": "pdf-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # Register actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/create",
            "action": "create-document",
            "display_name": "Create Document",
            "short_desc": "Create a new PDF document",
            "desc": "Create a PDF document from blank or text pages",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/info",
            "action": "get-document-info",
            "display_name": "Get Document Info",
            "short_desc": "Get PDF metadata and page count",
            "desc": "Read document metadata and page count without modifying the file",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/metadata",
            "action": "set-document-metadata",
            "display_name": "Set Document Metadata",
            "short_desc": "Update PDF metadata",
            "desc": "Update document metadata and write a new PDF",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/merge",
            "action": "merge-documents",
            "display_name": "Merge Documents",
            "short_desc": "Merge multiple PDFs",
            "desc": "Merge multiple PDF files into a single document",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/split",
            "action": "split-document",
            "display_name": "Split Document",
            "short_desc": "Split a PDF into pages",
            "desc": "Split a PDF into single-page files",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/rotate",
            "action": "rotate-pages",
            "display_name": "Rotate Pages",
            "short_desc": "Rotate specific pages",
            "desc": "Rotate selected pages by multiples of 90 degrees",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/add-image",
            "action": "add-image",
            "display_name": "Add Image",
            "short_desc": "Add images to PDF pages",
            "desc": "Add PNG, JPEG, or TIFF images to PDF pages with positioning, scaling, and rotation",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/add-text",
            "action": "add-text",
            "display_name": "Add Text",
            "short_desc": "Add styled text to PDF pages",
            "desc": "Add text to PDF pages with font, color, alignment, and rotation options",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/add-watermark",
            "action": "add-watermark",
            "display_name": "Add Watermark",
            "short_desc": "Add watermarks to PDF pages",
            "desc": "Add text or image watermarks to PDF pages with opacity, rotation, and tiling options",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/add-signature-field",
            "action": "add-signature-field",
            "display_name": "Add Signature Field",
            "short_desc": "Add signature placeholders",
            "desc": "Add signature placeholders to PDF pages with optional image, label, and line",
            "action_code": DPAT_API,
        });

        # Form field actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/list-form-fields",
            "action": "list-form-fields",
            "display_name": "List Form Fields",
            "short_desc": "List all form fields in a PDF",
            "desc": "List all form fields with their names, types, values, and properties",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/get-form-data",
            "action": "get-form-data",
            "display_name": "Get Form Data",
            "short_desc": "Get form field values",
            "desc": "Get values from all or selected form fields",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/fill-form",
            "action": "fill-form",
            "display_name": "Fill Form",
            "short_desc": "Fill form field values",
            "desc": "Fill form fields with values and optionally flatten to static content",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/create-form-field",
            "action": "create-form-field",
            "display_name": "Create Form Field",
            "short_desc": "Create new form fields",
            "desc": "Create text, checkbox, combo, list, radio, or button form fields",
            "action_code": DPAT_API,
        });

        # Encryption actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/encrypt",
            "action": "encrypt",
            "display_name": "Encrypt PDF",
            "short_desc": "Encrypt a PDF with password",
            "desc": "Encrypt a PDF document with owner and user passwords and permission restrictions",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/decrypt",
            "action": "decrypt",
            "display_name": "Decrypt PDF",
            "short_desc": "Remove encryption from a PDF",
            "desc": "Remove encryption from a PDF document using the owner password",
            "action_code": DPAT_API,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/get-encryption-info",
            "action": "get-encryption-info",
            "display_name": "Get Encryption Info",
            "short_desc": "Get PDF encryption information",
            "desc": "Get encryption status, algorithm, and permissions from a PDF document",
            "action_code": DPAT_API,
        });

        # Digital signature actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/create-signature-field",
            "action": "create-digital-signature-field",
            "display_name": "Create Signature Field",
            "short_desc": "Create a digital signature field",
            "desc": "Create a digital signature field placeholder for later signing",
            "action_code": DPAT_API,
        });

        # NOTE: sign-document action is disabled until OpenSSL integration is complete
        # DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
        #     "app": PdfDataProvider::AppName,
        #     "path": "/document/sign",
        #     "action": "sign-document",
        #     "display_name": "Sign Document",
        #     "short_desc": "Digitally sign a PDF",
        #     "desc": "Sign a PDF document with an X.509 certificate and private key",
        #     "action_code": DPAT_API,
        # });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": PdfDataProvider::AppName,
            "path": "/document/list-signatures",
            "action": "list-signatures",
            "display_name": "List Signatures",
            "short_desc": "List digital signatures",
            "desc": "List all digital signatures in a PDF document",
            "action_code": DPAT_API,
        });

        # Register render actions only if PDFium is available
        if (PdfRenderer::isAvailable()) {
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": PdfDataProvider::AppName,
                "path": "/render/page",
                "action": "render-page",
                "display_name": "Render Page",
                "short_desc": "Render a PDF page",
                "desc": "Render a PDF page to a raw bitmap using PDFium",
                "action_code": DPAT_API,
            });

            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": PdfDataProvider::AppName,
                "path": "/render/extract-text",
                "action": "extract-text",
                "display_name": "Extract Text",
                "short_desc": "Extract page text",
                "desc": "Extract text from a single PDF page using PDFium",
                "action_code": DPAT_API,
            });
        }
    };
}

/** @mainpage PdfDataProvider Module

    @tableofcontents

    @section pdfdpintro PDF DataProvider Introduction

    The PdfDataProvider module exposes PDF document creation, editing, and rendering
    operations through the Qore DataProvider API.

    Key classes:
    - @ref PdfDataProvider::PdfDataProviderFactory "PdfDataProviderFactory" - Factory for creating PDF data providers
    - @ref PdfDataProvider::PdfDataProvider "PdfDataProvider" - Root data provider
    - @ref PdfDataProvider::PdfDocumentDataProvider "PdfDocumentDataProvider" - Document manipulation operations
    - @ref PdfDataProvider::PdfRenderDataProvider "PdfRenderDataProvider" - Rendering and text extraction operations (requires PDFium)

    @section pdfdp_factory Factory Name

    Factory string for DataProvider::getFactoryEx(): "pdf"

    @section pdfdp_examples Examples

    @par API Example: Create a Document
    @verbatim qdp 'pdf{}/document/create' output_path=out.pdf,page_count=2 @endverbatim

    @par API Example: Merge Documents
    @verbatim qdp 'pdf{}/document/merge' inputs='("a.pdf","b.pdf")',output_path=merged.pdf @endverbatim

    @par API Example: Render a Page
    @verbatim qdp 'pdf{}/render/page' input_path=doc.pdf,page_index=0,dpi=150 @endverbatim

    @par API Example: Update Metadata
    @verbatim qdp 'pdf{}/document/metadata' input_path=in.pdf,output_path=out.pdf,metadata='{"title":"Updated"}' @endverbatim

    @par API Example: Rotate Pages
    @verbatim qdp 'pdf{}/document/rotate' input_path=in.pdf,output_path=rotated.pdf,pages='(0,1)',degrees=90 @endverbatim

    @par API Example: Extract Text
    @verbatim qdp 'pdf{}/render/extract-text' input_path=doc.pdf,page_index=0 @endverbatim
*/

public namespace PdfDataProvider {
    #! Application name
    public const AppName = "PDF";
}

namespace Priv {
    #! PDF logo (loaded at initialization)
    const PdfLogo = File::readTextFile(get_script_dir() + "/pdf-logo.svg");
}
